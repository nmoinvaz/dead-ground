// The site of Mapmaker's War at mapmakerswar.com: the page as static assets, a Room object for each game's lobby
// and play, and a Directory object that lists the rooms.
{
  "name": "mapmakers-war",
  "main": "server/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "mapmakerswar.com", "custom_domain": true },
    { "pattern": "www.mapmakerswar.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "DIR", "class_name": "Directory" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }
  ],
  "observability": { "enabled": true }
}
