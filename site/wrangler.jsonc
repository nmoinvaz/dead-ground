// The site of Mapmaker's War, served by the worker named dead-ground: the page as static assets, a Room object for
// each game's lobby and play, and a Directory object that lists the rooms.
{
  "name": "dead-ground",
  "main": "server/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "DIR", "class_name": "Directory" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["World"] },
    { "tag": "v2", "new_sqlite_classes": ["Room", "Directory"], "deleted_classes": ["World"] }
  ],
  "observability": { "enabled": true }
}
