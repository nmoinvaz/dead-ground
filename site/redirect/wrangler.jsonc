// The worker that served the game as Dead Ground, now a permanent redirect to mapmakerswar.com. Deploy with
// `npx wrangler deploy` in this folder. Its migrations are the old worker's own, unchanged.
{
  "name": "dead-ground",
  "main": "index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "DIR", "class_name": "Directory" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["World"] },
    { "tag": "v2", "new_sqlite_classes": ["Room", "Directory"], "deleted_classes": ["World"] }
  ]
}
