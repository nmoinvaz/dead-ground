// Dead Ground's shared world: the page as static assets, and one Durable Object that runs the world.
{
  "name": "dead-ground",
  "main": "server/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "observability": { "enabled": true }
}
